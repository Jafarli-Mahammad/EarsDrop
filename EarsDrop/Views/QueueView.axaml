<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EarsDrop.ViewModels" xmlns:controls="using:EarsDrop.Controls" x:Class="EarsDrop.Views.QueueView" x:DataType="vm:QueueViewModel">
  <ScrollViewer><StackPanel Margin="42,34" Spacing="28">
    <StackPanel Spacing="6"><TextBlock Text="Downloads" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Turn a link into a file in your library." Opacity=".6"/></StackPanel>
    <Border Classes="surface" Padding="18"><Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10"><Button Grid.Column="0" Content="Paste" Command="{Binding PasteCommand}"/><TextBox Grid.Column="1" PlaceholderText="Paste a YouTube, SoundCloud, Vimeo or Bandcamp link" Text="{Binding Url}"/><ComboBox Grid.Column="2" Width="82" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}"/><Button Grid.Column="3" Classes="accent" Content="Download" Command="{Binding StartDownloadCommand}"/></Grid></Border>
    <TextBlock Text="{Binding Feedback}" Opacity=".62"/>
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Current downloads" FontSize="18" FontWeight="SemiBold"/><ToggleSwitch Grid.Column="1" Content="Auto-download clipboard" IsChecked="{Binding AutoDownload}"/></Grid>
    <ItemsControl ItemsSource="{Binding Downloads}"><ItemsControl.ItemTemplate><DataTemplate><controls:DownloadCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></ScrollViewer>
</UserControl>
