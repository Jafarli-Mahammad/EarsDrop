<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EarsDrop.ViewModels"
             x:Class="EarsDrop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="42,34" Spacing="25">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" />
          <TextBlock Text="Make EarsDrop feel like yours." Opacity=".6" />
        </StackPanel>
        <Button Grid.Column="1" Classes="accent" Content="Save" Command="{Binding SaveCommand}" />
      </Grid>

      <Border Classes="surface" Padding="20">
        <StackPanel Spacing="13">
          <TextBlock Text="General" FontSize="18" FontWeight="SemiBold" />
          <ToggleSwitch Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
          <ToggleSwitch Content="Monitor clipboard" IsChecked="{Binding MonitorClipboard}" />
          <ToggleSwitch Content="Automatically download detected links" IsChecked="{Binding AutoDownload}" />
          <ToggleSwitch Content="Minimize to tray" IsChecked="{Binding MinimizeToTray}" />
        </StackPanel>
      </Border>

      <Border Classes="surface" Padding="20">
        <StackPanel Spacing="12">
          <TextBlock Text="Downloads" FontSize="18" FontWeight="SemiBold" />
          <TextBox PlaceholderText="Download folder" Text="{Binding DownloadFolder}" />
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding DefaultFormat}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Qualities}" SelectedItem="{Binding DefaultQuality}" />
            <NumericUpDown Grid.Column="2" Minimum="1" Maximum="10" Value="{Binding MaximumSimultaneousDownloads}" />
          </Grid>
          <TextBlock Text="Clipboard duplicate cooldown (seconds)" Opacity=".6" />
          <NumericUpDown Minimum="0" Maximum="30" Value="{Binding ClipboardDuplicateCooldownSeconds}" />
          <TextBlock Text="Clipboard poll interval (ms)" Opacity=".6" />
          <NumericUpDown Minimum="10" Maximum="1000" Value="{Binding ClipboardPollIntervalMilliseconds}" />
        </StackPanel>
      </Border>

      <Border Classes="surface" Padding="20">
        <StackPanel Spacing="12">
          <TextBlock Text="Metadata" FontSize="18" FontWeight="SemiBold" />
          <ToggleSwitch Content="Fetch metadata" IsChecked="{Binding FetchMetadata}" />
          <ToggleSwitch Content="Embed cover art" IsChecked="{Binding EmbedCoverArt}" />
          <ToggleSwitch Content="Write ID3 tags" IsChecked="{Binding WriteId3Tags}" />
        </StackPanel>
      </Border>

      <Border Classes="surface" Padding="20">
        <StackPanel Spacing="12">
          <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Accents}" SelectedItem="{Binding AccentColor}" />
          </Grid>
          <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" />
        </StackPanel>
      </Border>

      <Border Classes="surface" Padding="20">
        <StackPanel Spacing="12">
          <TextBlock Text="Paths" FontSize="18" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <TextBox Grid.Column="0" PlaceholderText="yt-dlp path" Text="{Binding YtDlpPath}" />
            <TextBox Grid.Column="1" PlaceholderText="ffmpeg path" Text="{Binding FfmpegPath}" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>