<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EarsDrop.ViewModels" xmlns:views="using:EarsDrop.Views" x:Class="EarsDrop.Views.DownloadHistoryView" x:DataType="vm:DownloadHistoryViewModel">
  <ScrollViewer><StackPanel Margin="42,34" Spacing="24">
    <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Text="History" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Your completed and saved downloads." Opacity=".6"/></StackPanel><Button Grid.Column="1" Classes="accent" Content="Refresh" Command="{Binding RefreshCommand}"/></Grid>
    <Grid ColumnDefinitions="*,160" ColumnSpacing="10"><TextBox Watermark="Search title or artist" Text="{Binding SearchText}"/><ComboBox Grid.Column="1" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}"/></Grid>
    <ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DownloadCardViewModel"><Border Classes="surface" Padding="15" Margin="0,0,0,9"><Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="14"><Border Width="54" Height="54" CornerRadius="10" Background="{DynamicResource CardMuted}"/><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" Opacity=".6"/><TextBlock Text="{Binding OutputPath}" FontSize="12" Opacity=".5" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"><Button Content="Open" Command="{Binding $parent[views:DownloadHistoryView].((vm:DownloadHistoryViewModel)DataContext).OpenFolderCommand}" CommandParameter="{Binding}"/><Button Content="Retry" Command="{Binding $parent[views:DownloadHistoryView].((vm:DownloadHistoryViewModel)DataContext).RetryCommand}" CommandParameter="{Binding}"/><Button Content="Delete" Command="{Binding $parent[views:DownloadHistoryView].((vm:DownloadHistoryViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></ScrollViewer>
</UserControl>
