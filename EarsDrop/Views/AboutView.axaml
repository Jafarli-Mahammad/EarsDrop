<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EarsDrop.ViewModels" x:Class="EarsDrop.Views.AboutView" x:DataType="vm:AboutViewModel"><StackPanel Margin="42,34" Spacing="16"><TextBlock Text="EarsDrop" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="{Binding Version}" Opacity=".6"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="480"/></StackPanel></UserControl>
